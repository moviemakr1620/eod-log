# Copy to .env and fill in. .env is NOT committed to git.

# ---- Access (required) ----
# Shared team password everyone types once per phone (they stay signed in for SESSION_DAYS).
APP_PASSWORD=change-me-team-password
# Optional admin password: needed for Settings, sending the summary, and deleting entries.
# Leave empty and every signed-in person can do those things.
ADMIN_PASSWORD=change-me-admin-password
# SESSION_DAYS=180
# SESSION_SECRET=           # optional; if empty a random one is created in the data volume

# ---- Network ----
# host port: http://<nas-ip>:7240
EOD_PORT=7240
# Full address people open, used for links in the weekly email (no trailing slash)
PUBLIC_URL=http://nas.local:7240
# COOKIE_SECURE=auto        # auto = Secure cookie when the request came in over https (via NPM)
# TRUST_PROXY=loopback, linklocal, uniquelocal

# ---- App ----
# APP_NAME=EOD Log
# COMPANY_NAME=KPI
APP_TIMEZONE=America/New_York
# MAX_UPLOAD_MB=20

# ---- Weekly summary email (SMTP) ----
# Gmail / Google Workspace: smtp.gmail.com, port 587, SMTP_USER=the address, SMTP_PASS=an App Password.
# Microsoft 365: smtp.office365.com, port 587 (SMTP AUTH must be enabled for the mailbox).
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=             # true for port 465; leave empty for 587 (STARTTLS)
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EOD Log <eod@example.com>"
# SMTP_TLS_REJECT_UNAUTHORIZED=true   # set false only for a NAS mail relay with a self-signed cert

# Starting values for the Settings page (the page can change them later; saved in the database)
MANAGER_EMAILS=manager1@example.com, manager2@example.com
# SUMMARY_ENABLED=true
# 0=Sunday 1=Monday ... 6=Saturday
SUMMARY_DAY=1
SUMMARY_TIME=08:00
# SUMMARY_TIMEZONE=America/New_York
# SUMMARY_ATTACH_RECEIPTS=false
